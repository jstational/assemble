name: "Test"

on:
  push:
    branches:
      ["main"]

jobs:
  test:
    name: "Test"
    runs-on: "ubuntu-latest"

    steps:
      - uses: "actions/checkout@v7"

      - name: "Install JDK"
        uses: "actions/setup-java@v6"
        with:
          java-version: "17"
          distribution: "temurin"

      - name: "Extract correct gradle script"
        run: cp ./gradle/test.build.gradle.kts ./build.gradle.kts
      
      - name: "Setup gradle"
        uses: "gradle/actions/setup-gradle@v6

      - name: "Test"
        run: |
          chmod +x ./gradlew
          ./gradlew test